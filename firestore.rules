rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required)
    //   - email: string (required)
    //   - displayName: string
    //   - organization: string
    //   - tier: string (required, enum: Anchor, Participant, Observer, Associate, Pending)
    //   - verified: bool (required)
    //   - createdAt: timestamp
    //
    // Collection: initiatives
    // Document ID: {initiativeId}
    // Fields:
    //   - id: string
    //   - name: string (required)
    //   - trackId: string (required)
    //   - description: string
    //   - status: string (required)
    //   - ownerUid: string
    //
    // Collection: companies
    // Document ID: {companyId}
    // Fields:
    //   - uid: string (required)
    //   - description: string (required)
    //   - offers: list (required)
    //   - seeks: string
    //   - quantityPerYear: string
    //   - frequency: string
    //   - wasteProcessing: string
    //   - certifications: list
    //   - transportPreference: list
    //   - borderRegion: string (required)
    //   - logoUrl: string
    //   - createdAt: timestamp
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tier == 'Anchor' ||
         (request.auth.token.email == "bramfledderus@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'tier', 'verified']) &&
             data.uid is string &&
             data.email is string &&
             data.tier in ['Anchor', 'Participant', 'Observer', 'Associate', 'Pending'] &&
             data.verified is bool;
    }

    function isValidCompany(data) {
      return data.keys().hasAll(['uid', 'description', 'offers', 'borderRegion']) &&
             data.uid is string &&
             data.description is string &&
             data.offers is list &&
             data.borderRegion is string;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin()) && isValidUser(request.resource.data);
    }

    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid && isValidCompany(request.resource.data);
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid && isValidCompany(request.resource.data);
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /initiatives/{initiativeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidUser(get(/databases/$(database)/documents/users/$(request.auth.uid)).data);
      allow update, delete: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }
  }
}
